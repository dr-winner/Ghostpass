# Real watcher settings; start:watcher loads .env from the project root.
ZWATCH_PORT=8787
ZWATCH_DATA_DIR=.local/zwatch
ZCASH_DEVTOOL=.local/bin/zcash-devtool
ZWATCH_SERVER=zecrocks
# Generate a local token, e.g. openssl rand -hex 32. Never commit it.
ZWATCH_API_TOKEN=
ZWATCH_SYNC_INTERVAL_MS=20000
ZWATCH_MAX_SNAPSHOT_AGE_MS=120000

# Matcher integration (the merchant accountId is returned by POST /accounts).
ZWATCH_URL=http://127.0.0.1:8787
MERCHANT_ACCOUNT_ID=
MERCHANT_UA=

# Demo merchants and dashboard (pnpm start:demo). `pnpm dev` needs none of these.
# Key-encryption key for issuer private keys: openssl rand -hex 32. Never commit it.
GP_KEK_HEX=
# Public KEYS.json the browser checks issuer keys against (raw file in the public repo).
GP_KEYS_URL=https://raw.githubusercontent.com/big14way/Ghostpass/main/KEYS.json
# Local file the merchants append new key hashes to; commit it to the public repo.
GP_KEYS_LOG=KEYS.json
# Dashboard HTTP Basic password, 16+ characters.
GP_ADMIN_PASSWORD=
GP_HOST=127.0.0.1
NEWSLETTER_PORT=3000
API_DEMO_PORT=3001
DASHBOARD_PORT=3002
# Simulated payments for local testing only; refused when NODE_ENV=production.
GP_DEV_FAKE_PAYMENTS=0
